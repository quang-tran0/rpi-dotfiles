% Update System
# Update system with Arch News and pacnew check

BLUE='\033[1;34m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
CYAN='\033[1;36m'
RESET='\033[0m'

helper=$(command -v paru || command -v yay)

if [ -z "$helper" ]; then
    echo -e "${RED}Error:${RESET} No supported AUR helper found (paru or yay)."
    exit 1
fi

echo -e "${CYAN}==> System Update${RESET}"
echo -e "${BLUE}Using AUR helper:${RESET} $(basename "$helper")"

if command -v checkupdates >/dev/null 2>&1; then
    echo -e "${BLUE}Checking for package updates...${RESET}"
    updates=$(checkupdates 2>/dev/null | wc -l)
    echo -e "${GREEN}$updates${RESET} package(s) available."
fi

echo
echo -e "${CYAN}==> Arch News${RESET}"
"$helper" -Pww

echo
echo -e "${BLUE}Press Enter to continue with the system update...${RESET}"
read -r
echo

echo -e "${CYAN}==> Updating System${RESET}"
"$helper" -Syu

if command -v pacdiff >/dev/null 2>&1; then
    pacnew_count=$(find /etc -name "*.pacnew" 2>/dev/null | wc -l)

    if [ "$pacnew_count" -gt 0 ]; then
        echo
        echo -e "${YELLOW}$pacnew_count .pacnew file(s) detected.${RESET}"
        echo -e "${YELLOW}Run 'sudo pacdiff' to review and merge them.${RESET}"
    else
        echo -e "${GREEN}No .pacnew files found.${RESET}"
    fi
fi

orphans=$(pacman -Qdtq 2>/dev/null | wc -l)

if [ "$orphans" -gt 0 ]; then
    echo -e "${YELLOW}$orphans orphan package(s) detected.${RESET}"
else
    echo -e "${GREEN}No orphan packages detected.${RESET}"
fi

echo
echo -e "${GREEN}System update completed successfully.${RESET}"



% Grub Make Config
# Grub Make Config
sudo grub-mkconfig -o /boot/grub/grub.cfg





% Rescan Mirrors
# Update system mirrors via Reflector
sudo pacman -S --needed reflector
sudo cp /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
sudo reflector --verbose --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist



% Clear Cache and Orphans
# Clean pacman cache (kept latest 1 versions) and remove all orphans
paccache -rk1
echo "Pacman cache cleaned (kept latest 1 versions)."

orphans=$(pacman -Qdtq 2>/dev/null)
[ -n "$orphans" ] && sudo pacman -Rns --noconfirm $orphans
echo "Official orphan packages removed."

if command -v paru >/dev/null 2>&1; then
    paru -Yc --noconfirm
elif command -v yay >/dev/null 2>&1; then
    yay -Yc --noconfirm
fi
echo "AUR orphan packages removed."



% Setup Paru Helper
# Setup AUR paru helper for archlinux
cd ~
sudo pacman -S --needed base-devel git
git clone https://aur.archlinux.org/paru.git
cd paru
makepkg -si
cd ..
rm -rf paru



% Quick Install Packages
# Auto install all packages from $CHEZMOI_DIR/packages.txt
helper=$(command -v paru || command -v yay)

if [ -z "$helper" ]; then
    echo "No supported AUR helper found (paru or yay)."
    exit 1
fi

echo "Using AUR helper: $(basename "$helper")"

while IFS= read -r pkg; do
    [ -z "$pkg" ] && continue
    [[ "$pkg" =~ ^# ]] && continue

    echo "Installing $pkg..."
    "$helper" -S --needed --noconfirm "$pkg"
done < "$CHEZMOI_DIR/packages.txt"

echo "Package installation completed."



% Setup oh-my-zsh
# Install oh-my-zsh and install all needed plugin
cd ~
sudo pacman -S --needed zsh
sudo pacman -S --needed starship
echo "==== Installing oh-my-zsh ===="
rm -rf ~/.oh-my-zsh/
sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
echo "==== Installing plugin ===="
git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting
git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions
git clone https://github.com/zsh-users/zsh-history-substring-search ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-history-substring-search
git clone https://github.com/MichaelAquilina/zsh-auto-notify.git $ZSH_CUSTOM/plugins/auto-notify
git clone https://github.com/MichaelAquilina/zsh-you-should-use.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/you-should-use
chsh -s /bin/zsh
chezmoi apply


% Install CachyOS Kernel
# Download and setup Cachyos kernel
cd ~
curl -O https://mirror.cachyos.org/cachyos-repo.tar.xz
tar xvf cachyos-repo.tar.xz && cd cachyos-repo

sudo ./cachyos-repo.sh
cd ..
rm -rf cachyos-repo





% Install Gaming Package    
# Download gaming package from Cachyos and setup gamemode
sudo pacman -S --needed cachyos-gaming-meta cachyos-gaming-applications
sudo pacman -S --needed power-profiles-daemon
sudo systemctl enable --now power-profiles-daemon
sudo pacman -S --needed gamemode
sudo usermod -aG gamemode ${whoami}
systemctl --user enable --now gamemoded





% Set Up Git Credential Manager
git-credential-manager configure
git config --global --replace-all credential.helper manager
git config --global credential.credentialStore secretservice
